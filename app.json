{
  "expo": {
    "name": "コトノハメモ",
    "slug": "kotonoha",
    "scheme": "kotonoha",
    "icon": "./assets/icon.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "net.phihash.kotonoha"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "ios": {
      "bundleIdentifier": "net.phihash.kotonoha",
      "usesAppleSignIn": true,
      "buildNumber": "3",
      "appleTeamId": "XVM4X7JGBU",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#192543"
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "disableAndroid": true
        }
      ]
    ],
    "version": "1.1.0",
    "extra": {
      "eas": {
        "projectId": "d0676cf2-f2bc-4eb3-87f6-e513c5865e07"
      }
    },
    "owner": "phihash",
    "updates": {
      "url": "https://u.expo.dev/d0676cf2-f2bc-4eb3-87f6-e513c5865e07",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
