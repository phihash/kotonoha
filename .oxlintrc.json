{
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "jsPlugins": ["./lint/design.mjs"],
  "ignorePatterns": ["ios/**", "dist/**"],
  "rules": {
    "design/no-raw-style": "error"
  },
  "overrides": [
    {
      "files": ["components/theme.ts", "lint/**"],
      "rules": { "design/no-raw-style": "off" }
    }
  ]
}
